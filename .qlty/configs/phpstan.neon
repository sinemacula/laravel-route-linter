parameters:
    scanDirectories:
        - %currentWorkingDirectory%/src
        - %currentWorkingDirectory%/benchmarks
        - %currentWorkingDirectory%/tests

    paths:
        - src
        - benchmarks
        - tests

    # The supported PHP range, so rules for newer PHP (e.g. #[\Override] on properties) are not demanded on 8.3.
    phpVersion:
        min: 80300
        max: 80599
